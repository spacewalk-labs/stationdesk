+            let method = request.get("method").and_then(Value::as_str).unwrap_or("");
+            let params = request.get("params").cloned().unwrap_or(json!({}));
+            let (req, _pending) = ControlRequest::new(method, params);
+            let response = match cadcraft_ui_egui::control::handle(app, ctx, &req) {
+                Outcome::Done(value) => value,
+                _ => json!({"ok": false, "error": "not immediate"}),
+            };
+            let ok = response.get("ok").and_then(Value::as_bool).unwrap_or(false);
+            let value = response.get("result").cloned().unwrap_or(Value::Null);
+            let error = response.get("error").cloned().unwrap_or(Value::Null);
+            let payload = if ok { value } else { error };
+            let encoded = serde_json::to_string(&payload).unwrap_or_else(|_| "null".into());
