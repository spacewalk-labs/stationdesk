# Copy to state/publish.env (0600), edit, then restart stationdesk-publish.
# Without any of PUBLIC_MODE / INGEST_URL / BASE_URL set here, Publish uses Tailscale
# Funnel. Setting one of them means your own target: no Funnel is opened.
STATIONDESK_PUBLISH_PUBLIC_MODE=local
STATIONDESK_PUBLISH_BASE_URL=https://docs.example.test
STATIONDESK_PUBLISH_PUBLIC_DIR=/opt/stationdesk/share-public
STATIONDESK_PUBLISH_GATED_DIR=/opt/stationdesk/share-gated
STATIONDESK_PUBLISH_HTPASSWD_DIR=/opt/stationdesk/publish-gated-auth
# Optional direct document link origin (default: https://${STATIONDESK_FQDN}:8000
# when STATIONDESK_FQDN is set; otherwise the UI uses /publish/files/).
# STATIONDESK_PUBLISH_DOC_URL=https://desk.example.test:8000
# For a separately hosted ingest receiver use PUBLIC_MODE=remote and set:
# STATIONDESK_PUBLISH_INGEST_URL=https://ingest.example.test
# STATIONDESK_PUBLISH_TOKEN_ENV=STATIONDESK_PUBLISH_TOKEN
# STATIONDESK_PUBLISH_TOKEN=<set privately, never commit>
# STATIONDESK_PUBLISH_TOKEN_HEADER=X-StationDesk-Publish-Token

# Site name and favicon (optional). Shown in the manager header and tab, and the favicon
# is added to externally published pages that have no <link rel="icon"> of their own.
# Defaults: "Publish" and the built-in icon. A relative favicon path is read from this
# file's folder; .svg/.png/.ico/.gif/.jpg/.webp up to 256 KB.
# STATIONDESK_PUBLISH_SITE_NAME=Team Docs
# STATIONDESK_PUBLISH_FAVICON=/opt/stationdesk/state/favicon.png
